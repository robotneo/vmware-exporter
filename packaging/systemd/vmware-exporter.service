[Unit]
Description=VMware vSphere Exporter (Prometheus)
Documentation=https://github.com/robotneo/vmware-exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# 配置全部来自 /etc/vmware-exporter/config.yaml。
#
# 不把凭证写在 ExecStart 上：命令行会进 /proc/<pid>/cmdline，主机上任何
# 用户都能用 ps 看到密码。
#
# 优先级：命令行 > -file > 环境变量（见 internal/config/config.go）。
#
# config.yaml 由 install.sh 安装为 vmware-exporter:vmware-exporter 0600，
# 下面以该静态系统账号运行，进程正好能读、同机其他用户读不到密码。
# 不用 DynamicUser：临时 uid 读不了 root:root 0600，而把配置放开到 0644
# 会让本机任意用户 cat 到 vCenter 密码（这正是本次修复的漏洞）。静态账号
# 同时完整保留 SIGHUP 原地热重载（-file 直接读磁盘上的文件）。
ExecStart=/usr/bin/vmware-exporter -file=/etc/vmware-exporter/config.yaml

# SIGHUP 原地重载配置。
#
# exporter 装了 SIGHUP handler，会重新读取 -file 并把值写回请求路径读的那些
# flag。每次抓取都会重读采集器开关，每次登录都会重读 vmware.* 凭证，所以下
# 一轮抓取就会用上新配置 —— 不用重启，指标不断点。
#
# 重载失败会保留旧配置，并把 vmware_exporter_config_last_reload_successful
# 置 0 —— 请对这个指标告警，因为 `systemctl reload` 仍然退出 0（信号确实送
# 到了）。
#
# 这三个改了必须重启，不能靠 reload：
#   -http.address      监听端口已经绑定
#   -web.config.file   TLS 与 basic auth 在 listen 时加载
#   -log.format        日志 handler 类型在构造时固定
# 改这些会在日志里出 warning，而不是静默生效。
ExecReload=/bin/kill -HUP $MAINPID

# SIGTERM 是 Go 的默认清理退出信号，exporter 收到会正常退出。不需要写
# ExecStop —— systemd 自己会把 KillSignal 发给主进程，手写 ExecStop 只是
# 多一个出错的机会。
KillSignal=SIGTERM
TimeoutStopSec=20

Restart=on-failure
RestartSec=5

# ── 安全加固 ────────────────────────────────────────────────────────────
#
# 以一个无家目录、不可登录的静态系统账号运行。install.sh 用
# `useradd --system` 保证幂等（已存在则不重建）。静态账号而非 DynamicUser
# 的原因：config.yaml 含 vCenter 密码，必须 0600；DynamicUser 的临时 uid
# 读不了 root:root 0600，逼出的 0644 是本机任意用户可读的泄密口。固定 uid
# 后 install.sh 把配置 chown 给该账号、权限收 0600，进程读得了、别人读不了，
# 而且 -file 直接读磁盘，SIGHUP 热重载不受影响。
User=vmware-exporter
Group=vmware-exporter

# exporter 只需要一个出站 TCP 连接和一个监听 socket，从不写盘，所以整个
# 文件系统可以只读。
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

# 只读：exporter 只会读配置。配合 ProtectSystem=strict，误写会直接失败
# 报错，而不是悄悄留下状态。
ReadOnlyPaths=/etc/vmware-exporter

# 65536 够一个监听 socket 加几百个并发 SOAP 连接。原来的 1048576 是抄来的，
# 和 LimitCORE=infinity 一起意味着一次崩溃能 dump 出好几个 GB 的 core。
LimitNOFILE=65536

# 进程堆里常驻 vCenter 凭证（-file 读入的密码、/probe 每请求凭证、会话 cookie），
# 一旦崩溃产生 core dump，这些明文会随内存镜像落盘 —— 即便运行账号是
# vmware-exporter，core 文件也可能被 systemd-coredump 收进全局目录、被 root 之外
# 的排障流程拷走。显式 LimitCORE=0 直接禁止内核写 core。
#
# 不影响排障：Go panic 与 SIGQUIT 的 goroutine 栈都打到 stderr（即 journal），
# 本二进制 CGO_ENABLED=0 静态构建、无可加载的本地符号，core 对应用层排错本就
# 没有额外价值。如需临时为某次崩溃抓 core，用
# `systemctl edit vmware-exporter` 覆盖本值并配好受保护的 coredump 目录。
LimitCORE=0

# 日志进 journal。StandardOutput=syslog 从 systemd 246 起已废弃，而且
# syslog= 本来也是路由到 journal 的。
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vmware-exporter

[Install]
WantedBy=multi-user.target
